{
  "name": "apex-rennstall",
  "version": "1.0.0",
  "description": "Rennspiel und Rennstall-Tycoon im Browser (React, TypeScript, three.js)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:artifact": "vite build --config vite.artifact.config.ts && node scripts/artifact.mjs",
    "build:portal": "tsc --noEmit && vite build --outDir dist-portal --emptyOutDir && node scripts/portal-package.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "store:assets": "node scripts/make-store-assets.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playgama/bridge": "^2.3.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module"
}
